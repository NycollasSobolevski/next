<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        
        xmlns:local="using:Next"
        xmlns:components="using:Next.Shared.Components"
        xmlns:mixer="using:Next.Shared.Components.VolumeMixer"
        xmlns:services="using:Next.Services"

        x:DataType="local:MainWindow"

        Background="#A800575E"
        TransparencyBackgroundFallback="AliceBlue"
        TransparencyLevelHint="AcrylicBlur"

        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Next.MainWindow"
        Title="Next">

        <StackPanel VerticalAlignment="Top">
                <components:Header/>
                <mixer:VolumeMixer Margin="10"/>
                <services:LogViewer/>
                <services:LogViewer/>
        </StackPanel>

</Window>